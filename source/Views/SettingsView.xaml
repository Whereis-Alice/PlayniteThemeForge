<UserControl x:Class="ThemeForge.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ThemeForge.ViewModels"
             xmlns:views="clr-namespace:ThemeForge.Views"
             xmlns:conv="clr-namespace:ThemeForge.Converters"
             d:DesignHeight="700" d:DesignWidth="1100"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <conv:StringToVisibilityConverter x:Key="TextToVis" />
    <conv:InvertBooleanConverter x:Key="Invert" />

    <!-- Compact toolbar button so the header does not eat vertical space. -->
    <Style x:Key="ToolButton" TargetType="Button">
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="MinWidth" Value="0" />
    </Style>

    <Style x:Key="RowLabel" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- ============================ value editors ============================ -->

    <DataTemplate x:Key="TplText">
      <TextBox Text="{Binding Value, UpdateSourceTrigger=LostFocus}" />
    </DataTemplate>

    <DataTemplate x:Key="TplBool">
      <CheckBox IsChecked="{Binding BoolValue}" VerticalAlignment="Center" />
    </DataTemplate>

    <DataTemplate x:Key="TplNumber">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="86" />
        </Grid.ColumnDefinitions>
        <Slider Grid.Column="0"
                VerticalAlignment="Center"
                Margin="0,0,8,0"
                Minimum="{Binding Slider.MinValue, Mode=OneWay}"
                Maximum="{Binding Slider.MaxValue, Mode=OneWay}"
                TickFrequency="{Binding Slider.StepValue, Mode=OneWay}"
                IsSnapToTickEnabled="True"
                SmallChange="{Binding Slider.StepValue, Mode=OneWay}"
                Value="{Binding NumberValue}"
                Visibility="{Binding HasSlider, Converter={StaticResource BoolToVis}}" />
        <TextBox Grid.Column="1" Text="{Binding NumberText, UpdateSourceTrigger=LostFocus}" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="TplChoice">
      <ComboBox ItemsSource="{Binding Choices}"
                SelectedItem="{Binding SelectedChoice}"
                DisplayMemberPath="Title" />
    </DataTemplate>

    <DataTemplate x:Key="TplFont">
      <!-- Editable so a font that is not installed locally is still preserved. Only Text is
           bound: binding SelectedItem as well makes the two fight over the same value. -->
      <ComboBox ItemsSource="{Binding Source={x:Static vm:OptionItemViewModel.SystemFonts}}"
                IsEditable="True" IsTextSearchEnabled="True"
                Text="{Binding FontValue, UpdateSourceTrigger=LostFocus}" />
    </DataTemplate>

    <!-- Colour and brush: swatch opens a self contained ARGB picker, no WinForms needed. -->
    <DataTemplate x:Key="TplColor">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ToggleButton x:Name="PickerToggle" Grid.Column="0" Width="52" Height="24" Padding="2" Margin="0,0,8,0">
          <Border BorderThickness="1" BorderBrush="{DynamicResource NormalBorderBrush}" MinWidth="40" MinHeight="16">
            <Grid>
              <!-- Light backdrop so semi transparent values stay readable. -->
              <Rectangle Fill="#FFFFFFFF" />
              <Rectangle Fill="{Binding PreviewBrush}" />
            </Grid>
          </Border>
        </ToggleButton>

        <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=LostFocus}" FontFamily="Consolas" />

        <Popup IsOpen="{Binding IsChecked, ElementName=PickerToggle, Mode=TwoWay}"
               PlacementTarget="{Binding ElementName=PickerToggle}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Focusable="True">
          <Border Background="{DynamicResource PopupBackgroundBrush}"
                  BorderBrush="{DynamicResource PopupBorderBrush}"
                  BorderThickness="1" Padding="12" Margin="0,4,8,8">
            <Border.Effect>
              <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.4" />
            </Border.Effect>
            <StackPanel Width="272">
              <Border Height="34" BorderThickness="1" BorderBrush="{DynamicResource NormalBorderBrush}" Margin="0,0,0,10">
                <Grid>
                  <Rectangle Fill="#FFFFFFFF" />
                  <Rectangle Fill="{Binding PreviewBrush}" />
                </Grid>
              </Border>

              <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="20" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="38" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource LOCThemeForgeAlpha}" VerticalAlignment="Center" />
                <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding AlphaValue}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding AlphaValue}" HorizontalAlignment="Right" VerticalAlignment="Center" />
              </Grid>
              <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="20" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="38" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource LOCThemeForgeRed}" VerticalAlignment="Center" />
                <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding RedValue}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding RedValue}" HorizontalAlignment="Right" VerticalAlignment="Center" />
              </Grid>
              <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="20" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="38" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource LOCThemeForgeGreen}" VerticalAlignment="Center" />
                <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding GreenValue}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding GreenValue}" HorizontalAlignment="Right" VerticalAlignment="Center" />
              </Grid>
              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="20" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="38" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource LOCThemeForgeBlue}" VerticalAlignment="Center" />
                <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding BlueValue}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding BlueValue}" HorizontalAlignment="Right" VerticalAlignment="Center" />
              </Grid>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource LOCThemeForgeHex}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Grid.Column="1" FontFamily="Consolas" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
                <Button Grid.Column="2" Margin="8,0,0,0" Padding="8,2"
                        Content="{DynamicResource LOCThemeForgeReset}"
                        Command="{Binding ResetCommand}" />
              </Grid>
            </StackPanel>
          </Border>
        </Popup>
      </Grid>
    </DataTemplate>

    <!-- Chooses the editor from the value kind. String literals are converted to the enum by WPF. -->
    <Style x:Key="EditorHost" TargetType="ContentControl">
      <Setter Property="ContentTemplate" Value="{StaticResource TplText}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Kind}" Value="Boolean">
          <Setter Property="ContentTemplate" Value="{StaticResource TplBool}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Number">
          <Setter Property="ContentTemplate" Value="{StaticResource TplNumber}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Integer">
          <Setter Property="ContentTemplate" Value="{StaticResource TplNumber}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Duration">
          <Setter Property="ContentTemplate" Value="{StaticResource TplNumber}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="TimeSpan">
          <Setter Property="ContentTemplate" Value="{StaticResource TplNumber}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Color">
          <Setter Property="ContentTemplate" Value="{StaticResource TplColor}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Brush">
          <Setter Property="ContentTemplate" Value="{StaticResource TplColor}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Choice">
          <Setter Property="ContentTemplate" Value="{StaticResource TplChoice}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Visibility">
          <Setter Property="ContentTemplate" Value="{StaticResource TplChoice}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="HorizontalAlignment">
          <Setter Property="ContentTemplate" Value="{StaticResource TplChoice}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="VerticalAlignment">
          <Setter Property="ContentTemplate" Value="{StaticResource TplChoice}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="FontFamily">
          <Setter Property="ContentTemplate" Value="{StaticResource TplFont}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- One row: label, editor, reset. Used by both the options tab and the resources list. -->
    <DataTemplate x:Key="OptionRow" DataType="{x:Type vm:OptionItemViewModel}">
      <Grid Margin="0,3,0,3">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" MinWidth="140" />
          <ColumnDefinition Width="3*" MinWidth="180" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding DisplayTitle}" Style="{StaticResource RowLabel}"
                     ToolTip="{Binding ToolTipText}" />
          <TextBlock Text="{Binding Description}" Opacity="0.65" TextWrapping="Wrap" FontSize="11"
                     Visibility="{Binding Description, Converter={StaticResource TextToVis}}" />
        </StackPanel>

        <ContentControl Grid.Row="0" Grid.Column="1" Content="{Binding}" Style="{StaticResource EditorHost}" />

        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
          <TextBlock Text="*" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"
                     Foreground="{DynamicResource HighlightGlyphBrush}"
                     ToolTip="{DynamicResource LOCThemeForgeModified}"
                     Visibility="{Binding IsModified, Converter={StaticResource BoolToVis}}" />
          <Button Content="{DynamicResource LOCThemeForgeReset}" Command="{Binding ResetCommand}"
                  Padding="8,2" Margin="0,0,4,0"
                  IsEnabled="{Binding IsModified}" />
          <!-- The "#" button copies the raw resource key; the tooltip explains that so it is
               not mistaken for a generic "more" affordance, and shows the key in a mono font. -->
          <Button Content="#" Command="{Binding CopyKeyCommand}" Padding="8,2">
            <Button.ToolTip>
              <StackPanel MaxWidth="420">
                <TextBlock Text="{DynamicResource LOCThemeForgeCopyKey}" FontWeight="Bold" />
                <TextBlock Text="{Binding Key}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,3,0,0" />
              </StackPanel>
            </Button.ToolTip>
          </Button>
        </StackPanel>

        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding ValueError}"
                   Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" FontSize="11"
                   Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <DockPanel LastChildFill="True">

    <!-- ============================== header ============================== -->
    <Border DockPanel.Dock="Top" Padding="0,0,0,8" Margin="0,0,0,6"
            BorderThickness="0,0,0,1" BorderBrush="{DynamicResource PanelSeparatorBrush}">
      <StackPanel>
        <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="160" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{DynamicResource LOCThemeForgeTheme}" VerticalAlignment="Center" Margin="0,0,8,0" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableThemes}"
                    SelectedItem="{Binding SelectedTheme}" DisplayMemberPath="DisplayName" />
          <TextBlock Grid.Column="2" Text="{Binding ThemeSummary}" Opacity="0.7" VerticalAlignment="Center"
                     Margin="12,0,12,0" TextTrimming="CharacterEllipsis" MaxWidth="360" />
          <StackPanel Grid.Column="3" Orientation="Horizontal">
            <Button Content="{DynamicResource LOCThemeForgeReload}" Command="{Binding ReloadCommand}"
                    Style="{StaticResource ToolButton}" ToolTip="{DynamicResource LOCThemeForgeReloadHint}" />
            <Button Content="{DynamicResource LOCThemeForgeOpenFolder}" Command="{Binding OpenThemeFolderCommand}"
                    Style="{StaticResource ToolButton}" />
          </StackPanel>
        </Grid>

        <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="120" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{DynamicResource LOCThemeForgeProfile}" VerticalAlignment="Center" Margin="0,0,8,0" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                    DisplayMemberPath="Name" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0">
            <Button Content="{DynamicResource LOCThemeForgeSaveProfile}" Command="{Binding SaveProfileCommand}" Style="{StaticResource ToolButton}" />
            <Button Content="{DynamicResource LOCThemeForgeDeleteProfile}" Command="{Binding DeleteProfileCommand}" Style="{StaticResource ToolButton}" />
            <Border Width="1" Margin="4,2,10,2" Background="{DynamicResource PanelSeparatorBrush}" />
            <Button Content="{DynamicResource LOCThemeForgeExport}" Command="{Binding ExportCommand}" Style="{StaticResource ToolButton}" />
            <Button Content="{DynamicResource LOCThemeForgeImport}" Command="{Binding ImportCommand}" Style="{StaticResource ToolButton}" />
            <Button Content="{DynamicResource LOCThemeForgeResetAll}" Command="{Binding ResetAllCommand}" Style="{StaticResource ToolButton}" />
          </StackPanel>
        </Grid>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="140" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{DynamicResource LOCThemeForgeSearch}" VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}" />
          <Button Grid.Column="2" Content="X" Command="{Binding ClearSearchCommand}" Padding="8,2" Margin="4,0,12,0" />
          <StackPanel Grid.Column="3" Orientation="Horizontal">
            <CheckBox Content="{DynamicResource LOCThemeForgeShowOnlyModified}" IsChecked="{Binding ShowOnlyModified}"
                      VerticalAlignment="Center" Margin="0,0,14,0" />
            <CheckBox Content="{DynamicResource LOCThemeForgeLiveApply}" IsChecked="{Binding Settings.LiveApply}"
                      ToolTip="{DynamicResource LOCThemeForgeLiveApplyHint}" VerticalAlignment="Center" Margin="0,0,14,0" />
            <CheckBox Content="{DynamicResource LOCThemeForgePreview}" IsChecked="{Binding PreviewVisible}"
                      ToolTip="{DynamicResource LOCThemeForgePreviewHint}" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

    <!-- ============================== body ============================== -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="420" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TabControl Grid.Column="0">

        <!-- presets -->
        <TabItem Header="{DynamicResource LOCThemeForgeTabPresets}">
          <Grid>
            <TextBlock Text="{DynamicResource LOCThemeForgeNoPresets}" Opacity="0.7" Margin="10"
                       TextWrapping="Wrap" VerticalAlignment="Top">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Visible" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasPresets}" Value="True">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasPresets, Converter={StaticResource BoolToVis}}">
              <ItemsControl ItemsSource="{Binding Presets}" Margin="8">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource PanelSeparatorBrush}" Padding="0,8,0,10">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" FontWeight="Bold" />
                            <TextBlock Text="*" FontWeight="Bold" Margin="6,0,0,0"
                                       Foreground="{DynamicResource HighlightGlyphBrush}"
                                       ToolTip="{DynamicResource LOCThemeForgeModified}"
                                       Visibility="{Binding IsModified, Converter={StaticResource BoolToVis}}" />
                          </StackPanel>
                          <TextBlock Text="{Binding Description}" Opacity="0.65" TextWrapping="Wrap" FontSize="11"
                                     Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}" />
                          <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" MaxWidth="360" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" DisplayMemberPath="Name" />
                            <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.7"
                                       FontSize="11" TextWrapping="Wrap" MaxWidth="260"
                                       Text="{Binding SelectedDescription}" />
                          </Grid>
                          <TextBlock Text="{DynamicResource LOCThemeForgeNeedsRestart}" FontSize="11" Margin="0,4,0,0"
                                     Foreground="{DynamicResource WarningBrush}"
                                     Visibility="{Binding NeedRestart, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <Image Grid.Column="1" Source="{Binding PreviewImage}" MaxHeight="110" MaxWidth="200"
                               Margin="12,0,0,0" Stretch="Uniform"
                               Visibility="{Binding HasPreview, Converter={StaticResource BoolToVis}}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </TabItem>

        <!-- theme options -->
        <TabItem Header="{DynamicResource LOCThemeForgeTabOptions}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,6,8,6">
              <Button Content="{DynamicResource LOCThemeForgeExpandAll}" Command="{Binding ExpandAllCommand}" Style="{StaticResource ToolButton}" />
              <Button Content="{DynamicResource LOCThemeForgeCollapseAll}" Command="{Binding CollapseAllCommand}" Style="{StaticResource ToolButton}" />
              <TextBlock Text="{DynamicResource LOCThemeForgeNoOptions}" Opacity="0.7" VerticalAlignment="Center"
                         TextWrapping="Wrap" MaxWidth="520" Margin="10,0,0,0">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasOptions}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Groups}" Margin="8,0,8,8">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Expander IsExpanded="{Binding IsExpanded}" Margin="0,0,0,4"
                              Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
                      <Expander.Header>
                        <TextBlock Text="{Binding Header}" FontWeight="Bold" />
                      </Expander.Header>
                      <StackPanel Margin="14,6,0,8">
                        <TextBlock Text="{Binding Description}" Opacity="0.65" TextWrapping="Wrap" FontSize="11"
                                   Margin="0,0,0,6"
                                   Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}" />
                        <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource OptionRow}" />
                      </StackPanel>
                    </Expander>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </TabItem>

        <!-- raw resources -->
        <TabItem Header="{DynamicResource LOCThemeForgeTabResources}">
          <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="8,6,8,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <CheckBox Content="{DynamicResource LOCThemeForgeShowAllResources}" IsChecked="{Binding ShowAllResources}"
                        ToolTip="{DynamicResource LOCThemeForgeShowAllResourcesHint}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding ResourceSummary}" Opacity="0.7" HorizontalAlignment="Right"
                         VerticalAlignment="Center" />
            </Grid>
            <Grid>
              <!-- Empty state: the resource list can legitimately be empty when a filter matches
                   nothing, so explain that instead of showing a blank panel. -->
              <TextBlock Text="{DynamicResource LOCThemeForgeNoResources}" Opacity="0.7" Margin="10"
                         TextWrapping="Wrap" VerticalAlignment="Top">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Resources.Count}" Value="0">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <ListBox ItemsSource="{Binding Resources}"
                       ItemTemplate="{StaticResource OptionRow}"
                       HorizontalContentAlignment="Stretch"
                       BorderThickness="0"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       VirtualizingPanel.IsVirtualizing="True"
                       VirtualizingPanel.VirtualizationMode="Recycling"
                       VirtualizingPanel.ScrollUnit="Pixel">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="4,2" />
                    <Setter Property="Focusable" Value="False" />
                  </Style>
                </ListBox.ItemContainerStyle>
              </ListBox>
            </Grid>
          </DockPanel>
        </TabItem>

        <!-- extensions the theme wants -->
        <TabItem Header="{DynamicResource LOCThemeForgeTabExtensions}">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">
              <TextBlock Text="{DynamicResource LOCThemeForgeMissingExtensionsNone}" Opacity="0.7" TextWrapping="Wrap">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasMissingExtensions}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <StackPanel Visibility="{Binding HasMissingExtensions, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{DynamicResource LOCThemeForgeMissingExtensionsHeader}" FontWeight="Bold" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding MissingExtensions}" Margin="10,6,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,1" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <StackPanel Margin="0,18,0,0" Visibility="{Binding HasUnresolvedKeys, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{DynamicResource LOCThemeForgeUnresolvedKeysHeader}" FontWeight="Bold" TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding UnresolvedKeys}" Margin="10,6,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}" TextWrapping="Wrap" FontFamily="Consolas" Margin="0,1" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <StackPanel Margin="0,18,0,0" Visibility="{Binding HasShadowedOverrides, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{DynamicResource LOCThemeForgeShadowedHeader}" FontWeight="Bold" TextWrapping="Wrap" />
                <TextBlock Text="{DynamicResource LOCThemeForgeShadowedHint}" TextWrapping="Wrap" Opacity="0.75" Margin="0,4,0,0" />
                <ItemsControl ItemsSource="{Binding ShadowedOverrides}" Margin="10,8,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" MinWidth="230" />
                          <ColumnDefinition Width="Auto" MinWidth="100" />
                          <ColumnDefinition Width="Auto" MinWidth="90" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Key}" FontFamily="Consolas" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="Consolas" Opacity="0.8" Margin="12,0,0,0" />
                        <TextBlock Grid.Column="2" Text="{Binding Scope}" Opacity="0.6" Margin="12,0,0,0" />
                        <TextBlock Grid.Column="3" Text="{Binding Reason}" Opacity="0.75" TextWrapping="Wrap" Margin="12,0,0,0" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="{DynamicResource LOCThemeForgeClearShadowed}" Command="{Binding ClearShadowedCommand}"
                        HorizontalAlignment="Left" Margin="10,10,0,0" Padding="12,4" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- plugin behaviour and about -->
        <TabItem Header="{DynamicResource LOCThemeForgeTabAbout}">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">
              <TextBlock Text="{DynamicResource LOCThemeForgeName}" FontWeight="Bold" FontSize="16" />
              <TextBlock Text="{DynamicResource LOCThemeForgeDescription}" TextWrapping="Wrap" Opacity="0.8" Margin="0,4,0,12" />

              <TextBlock Text="{DynamicResource LOCThemeForgeSettingsGeneral}" FontWeight="Bold" Margin="0,8,0,6" />
              <CheckBox Content="{DynamicResource LOCThemeForgeShowTopPanelButton}" IsChecked="{Binding Settings.ShowTopPanelButton}" Margin="0,2" />
              <CheckBox Content="{DynamicResource LOCThemeForgeMenuInExtensions}" IsChecked="{Binding Settings.MenuInExtensions}" Margin="0,2" />
              <CheckBox Content="{DynamicResource LOCThemeForgeNotifyMissingExtensions}" IsChecked="{Binding Settings.NotifyMissingExtensions}" Margin="0,2" />

              <Border Margin="0,16,0,0" Padding="10" BorderThickness="1"
                      BorderBrush="{DynamicResource NormalBorderBrush}"
                      Visibility="{Binding LegacyDataAvailable, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                  <TextBlock Text="{DynamicResource LOCThemeForgeLegacyAvailable}" TextWrapping="Wrap" />
                  <Button Content="{DynamicResource LOCThemeForgeMigrate}" Command="{Binding MigrateCommand}"
                          HorizontalAlignment="Left" Margin="0,8,0,0" Padding="10,4" />
                </StackPanel>
              </Border>

              <TextBlock Text="{DynamicResource LOCThemeForgeRestartHint}" Opacity="0.7" TextWrapping="Wrap" Margin="0,16,0,0" />

              <Grid Margin="0,16,0,0" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{DynamicResource LOCThemeForgeVersion}" Margin="0,0,12,2" />
                <TextBlock Grid.Column="1" Text="{Binding PluginVersion}" Margin="0,0,0,2" />
                <TextBlock Grid.Row="1" Text="{DynamicResource LOCThemeForgeHostVersion}" Margin="0,0,12,0" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding HostVersion}" />
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>

      <!-- live preview: its own resource scope so overrides can be tried without touching the app -->
      <Border Grid.Column="1" Width="380" Margin="10,0,0,0" BorderThickness="1,0,0,0"
              BorderBrush="{DynamicResource PanelSeparatorBrush}" Padding="10,0,0,0"
              Visibility="{Binding PreviewVisible, Converter={StaticResource BoolToVis}}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="{DynamicResource LOCThemeForgePreviewTitle}" FontWeight="Bold" Margin="0,0,0,6" />
          <TextBlock DockPanel.Dock="Top" Text="{DynamicResource LOCThemeForgePreviewHint}" Opacity="0.65"
                     FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" />
          <ContentControl x:Name="PreviewHost">
            <views:PreviewSurface />
          </ContentControl>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
