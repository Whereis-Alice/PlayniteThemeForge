<UserControl x:Class="ThemeForge.Views.PreviewSurface"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Mock up of the main window. Every colour, corner radius and font size is a DynamicResource
    so the surrounding preview scope can override it without a restart. Nothing is bound to data.
  -->
  <Border BorderThickness="1" BorderBrush="{DynamicResource StandardWindowBorderBrush}"
          Background="{DynamicResource WindowBackgourndBrush}">
    <DockPanel>

      <!-- top panel -->
      <Border DockPanel.Dock="Top" Background="{DynamicResource ControlBackgroundBrush}"
              BorderThickness="0,0,0,1" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}" Padding="8,6">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{DynamicResource LOCThemeForgePreviewLibrary}" FontWeight="Bold"
                     Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
          <Border Grid.Column="1" Margin="10,0,10,0" Padding="6,2"
                  CornerRadius="{DynamicResource ControlCornerRadius}"
                  Background="{DynamicResource NormalBrush}"
                  BorderThickness="1" BorderBrush="{DynamicResource NormalBorderBrush}">
            <TextBlock Text="{DynamicResource LOCThemeForgePreviewSearchPlaceholder}"
                       Foreground="{DynamicResource TextBrushDarker}" FontSize="11" />
          </Border>
          <StackPanel Grid.Column="2" Orientation="Horizontal">
            <Ellipse Width="12" Height="12" Margin="3,0" Fill="{DynamicResource ControlsIconsGlyphBrush}" />
            <Ellipse Width="12" Height="12" Margin="3,0" Fill="{DynamicResource HighlightGlyphBrush}" />
            <Ellipse Width="12" Height="12" Margin="3,0" Fill="{DynamicResource GlyphBrush}" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- sidebar -->
      <Border DockPanel.Dock="Left" Width="46" Background="{DynamicResource NormalBrushDark}"
              BorderThickness="0,0,1,0" BorderBrush="{DynamicResource WindowPanelSeparatorBrush}">
        <StackPanel Margin="0,8,0,0">
          <Border Height="30" Margin="6,3" Background="{DynamicResource HoverBrush}"
                  CornerRadius="{DynamicResource ControlCornerRadiusSmall}">
            <Rectangle Width="14" Height="14" Fill="{DynamicResource HighlightGlyphBrush}" />
          </Border>
          <Border Height="30" Margin="6,3" CornerRadius="{DynamicResource ControlCornerRadiusSmall}">
            <Rectangle Width="14" Height="14" Fill="{DynamicResource GlyphBrush}" />
          </Border>
          <Border Height="30" Margin="6,3" CornerRadius="{DynamicResource ControlCornerRadiusSmall}">
            <Rectangle Width="14" Height="14" Fill="{DynamicResource GlyphBrush}" />
          </Border>
          <Border Height="30" Margin="6,3" CornerRadius="{DynamicResource ControlCornerRadiusSmall}">
            <Rectangle Width="14" Height="14" Fill="{DynamicResource GlyphBrush}" />
          </Border>
        </StackPanel>
      </Border>

      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
        <StackPanel>

          <!-- cover tiles -->
          <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Border Width="84" Height="118" Margin="0,0,8,0"
                    CornerRadius="{DynamicResource GridViewCoverCornerRadius}"
                    Background="{DynamicResource GridItemBackgroundBrush}"
                    BorderThickness="1" BorderBrush="{DynamicResource NormalBorderBrush}">
              <TextBlock Text="A" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Foreground="{DynamicResource TextBrushDark}" />
            </Border>
            <Border Width="84" Height="118" Margin="0,0,8,0" Padding="2"
                    CornerRadius="{DynamicResource GridViewSelectionBorderCornerRadius}"
                    BorderThickness="2" BorderBrush="{DynamicResource HighlightGlyphBrush}">
              <Border CornerRadius="{DynamicResource GridViewCoverCornerRadius}"
                      Background="{DynamicResource GridItemBackgroundBrush}">
                <TextBlock Text="B" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextBrush}" />
              </Border>
            </Border>
            <Border Width="84" Height="118"
                    CornerRadius="{DynamicResource GridViewCoverCornerRadius}"
                    Background="{DynamicResource GridItemBackgroundBrush}"
                    BorderThickness="1" BorderBrush="{DynamicResource NormalBorderBrush}">
              <TextBlock Text="C" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Foreground="{DynamicResource TextBrushDark}" />
            </Border>
          </StackPanel>

          <!-- details header -->
          <TextBlock Text="{DynamicResource LOCThemeForgePreviewSampleTitle}" FontSize="16" FontWeight="Bold"
                     Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap" />
          <TextBlock Text="{DynamicResource LOCThemeForgePreviewSampleSub}" FontSize="11" Margin="0,2,0,8"
                     Foreground="{DynamicResource TextBrushDarker}" TextWrapping="Wrap" />

          <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Border Padding="14,5" Margin="0,0,8,0" Background="{DynamicResource PlayButtonBackgroundBrush}"
                    CornerRadius="{DynamicResource ControlCornerRadius}"
                    BorderThickness="1" BorderBrush="{DynamicResource NormalBorderBrush}">
              <TextBlock Text="{DynamicResource LOCThemeForgePreviewPlay}" Foreground="{DynamicResource TextBrush}" />
            </Border>
            <Border Padding="14,5" Margin="0,0,8,0" Background="{DynamicResource ButtonBackgroundBrush}"
                    CornerRadius="{DynamicResource ControlCornerRadius}"
                    BorderThickness="1" BorderBrush="{DynamicResource NormalBorderBrush}">
              <TextBlock Text="{DynamicResource LOCThemeForgePreviewDetails}" Foreground="{DynamicResource TextBrush}" />
            </Border>
            <Border Padding="14,5" Background="{DynamicResource NormalBrush}"
                    CornerRadius="{DynamicResource DetailsViewExtraButtonsCornerRadius}"
                    BorderThickness="1" BorderBrush="{DynamicResource NormalBorderBrush}">
              <TextBlock Text="..." Foreground="{DynamicResource TextBrush}" />
            </Border>
          </StackPanel>

          <!-- progress bar, shows ProgressBarBrush and SliderFillCornerRadius -->
          <TextBlock Text="{DynamicResource LOCThemeForgePreviewProgress}" FontSize="11" Margin="0,0,0,3"
                     Foreground="{DynamicResource TextBrushDarker}" />
          <Border Height="10" Margin="0,0,0,10" Background="{DynamicResource SliderBackgroundBrush}"
                  CornerRadius="{DynamicResource SliderFillCornerRadius}">
            <Border HorizontalAlignment="Left" Width="150" Background="{DynamicResource ProgressBarBrush}"
                    CornerRadius="{DynamicResource SliderFillCornerRadius}" />
          </Border>

          <TextBlock Text="{DynamicResource LOCThemeForgePreviewDescription}" TextWrapping="Wrap" FontSize="11"
                     Foreground="{DynamicResource TextBrushDark}" Margin="0,0,0,10" />

          <!-- rating swatches, easy to compare at a glance -->
          <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Border Width="46" Height="16" Margin="0,0,4,0" Background="{DynamicResource PositiveRatingBrush}"
                    CornerRadius="{DynamicResource ControlCornerRadiusSmall}" />
            <Border Width="46" Height="16" Margin="0,0,4,0" Background="{DynamicResource MixedRatingBrush}"
                    CornerRadius="{DynamicResource ControlCornerRadiusSmall}" />
            <Border Width="46" Height="16" Margin="0,0,4,0" Background="{DynamicResource NegativeRatingBrush}"
                    CornerRadius="{DynamicResource ControlCornerRadiusSmall}" />
            <Border Width="46" Height="16" Background="{DynamicResource WarningBrush}"
                    CornerRadius="{DynamicResource ControlCornerRadiusSmall}" />
          </StackPanel>

          <!-- list rows -->
          <Border BorderThickness="1" BorderBrush="{DynamicResource NormalBorderBrush}"
                  CornerRadius="{DynamicResource ControlCornerRadius}"
                  Background="{DynamicResource ControlBackgroundBrush}">
            <StackPanel>
              <Border Padding="8,5" Background="{DynamicResource ExpanderBackgroundBrush}"
                      CornerRadius="{DynamicResource ControlCornerRadiusSmall}">
                <TextBlock Text="{DynamicResource LOCThemeForgePreviewExpander}" Foreground="{DynamicResource TextBrush}" FontSize="11" />
              </Border>
              <Border Padding="8,5" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource PanelSeparatorBrush}">
                <TextBlock Text="{DynamicResource LOCThemeForgePreviewRow1}" Foreground="{DynamicResource TextBrush}" FontSize="11" />
              </Border>
              <Border Padding="8,5" Background="{DynamicResource DetailsViewItemIsSelectedBackgroundBrush}"
                      CornerRadius="{DynamicResource ControlCornerRadiusSmall}"
                      BorderThickness="0,0,0,1" BorderBrush="{DynamicResource PanelSeparatorBrush}">
                <TextBlock Text="{DynamicResource LOCThemeForgePreviewRow2}" Foreground="{DynamicResource TextBrush}" FontSize="11" />
              </Border>
              <Border Padding="8,5">
                <TextBlock Text="{DynamicResource LOCThemeForgePreviewRow3}" Foreground="{DynamicResource TextBrushDarker}" FontSize="11" />
              </Border>
            </StackPanel>
          </Border>

          <!-- popup, tooltip and menu hover surfaces -->
          <Border Margin="0,10,0,0" Padding="4" Background="{DynamicResource PopupBackgroundBrush}"
                  CornerRadius="{DynamicResource ControlCornerRadius}"
                  BorderThickness="1" BorderBrush="{DynamicResource PopupBorderBrush}">
            <Border Padding="8,4" Background="{DynamicResource MenusHoverBrush}"
                    CornerRadius="{DynamicResource PopupsHoverBackgroundCornerRadius}">
              <TextBlock Text="{DynamicResource LOCThemeForgePreviewMenuItem}" Foreground="{DynamicResource TextBrush}" FontSize="11" />
            </Border>
          </Border>

          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <Border Padding="8,4" Margin="0,0,6,0" Background="{DynamicResource PopupBackgroundBrush}"
                    CornerRadius="{DynamicResource ControlCornerRadius}"
                    BorderThickness="1" BorderBrush="{DynamicResource PopupBorderBrush}">
              <TextBlock Text="{DynamicResource LOCThemeForgePreviewPopup}" Foreground="{DynamicResource TextBrush}" FontSize="11" />
            </Border>
            <Border Padding="8,4" Background="{DynamicResource TooltipBackgroundBrush}"
                    CornerRadius="{DynamicResource ControlCornerRadius}"
                    BorderThickness="1" BorderBrush="{DynamicResource NormalBorderBrush}">
              <TextBlock Text="{DynamicResource LOCThemeForgePreviewTooltip}" Foreground="{DynamicResource TextBrush}" FontSize="11" />
            </Border>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
